# Local CLI Bridge, example configuration.
#
# Copy this file to `.env.bridge.local` (kept gitignored) and fill in what you need.
# The bridge auto-loads the first of `.env.bridge.local` / `.env.local` that exists;
# ONLY `BRIDGE_*` keys and `CLOUDFLARED_BIN` are ever read from it, and values are
# never logged. Inline environment variables always win over the file.
# Every setting is optional unless noted.

# ── Core ─────────────────────────────────────────────────────────────────────

# Listen port (default 8787). PORT / BRIDGE_PORT are interchangeable.
#BRIDGE_PORT=8787

# Bind address (default 127.0.0.1). Keep it loopback, remote access goes through
# the Cloudflare tunnel, never through a wide bind.
#BRIDGE_HOST=127.0.0.1

# Backend: claude | codex | command | auto (auto dispatches by requested model id:
# Claude-family ids → claude, gpt-*/codex ids → codex).
#BRIDGE_BACKEND=auto

# auto mode only: backend used for an ambiguous model id (default claude).
#BRIDGE_AUTO_DEFAULT=claude

# command backend only: a quoted command template; {model} tokens are substituted
# and the prompt is piped to stdin. Quoting and backslash escapes are supported
# (a limited argv parser — NO shell expansion or substitution).
#BRIDGE_COMMAND=ollama run {model}

# command backend, exact form: a JSON array of strings, used verbatim. Wins over
# BRIDGE_COMMAND when both are set.
#BRIDGE_COMMAND_JSON=["ollama","run","{model}"]

# Default model id when a request omits one.
#BRIDGE_MODEL=

# Comma-separated model ids advertised on /v1/models (prefills a client's model
# dropdown). Include effort variants if you want them selectable, e.g. sonnet:xhigh.
#BRIDGE_MODELS="sonnet,sonnet:xhigh,opus,haiku,gpt-5.6-sol,gpt-5.6-sol:high,gpt-5.6-terra,gpt-5.6-luna:low,gpt-5.5"

# ── Auth ─────────────────────────────────────────────────────────────────────

# Bearer key callers must send as `Authorization: Bearer <key>`. Optional for
# loopback-only use; REQUIRED by bridge-tunnel.mjs (it fails closed without it).
#BRIDGE_API_KEY=<a-strong-random-key>

# Set 1 to KEEP provider API keys (ANTHROPIC_API_KEY, OPENAI_API_KEY, …) in the
# spawned CLI's environment. Default strips them so each CLI uses its own
# subscription login, the fix for "Not logged in" loops.
#BRIDGE_KEEP_ENV_KEYS=0

# ── Limits & timeouts ────────────────────────────────────────────────────────

# Per-request CLI timeout in ms (default 900000 = 15 min, long-running pipeline
# stages can take minutes).
#BRIDGE_TIMEOUT_MS=900000

# Max simultaneous CLI completions (default 4; excess requests get a 429).
# Single-user setups can lower this to 1.
#BRIDGE_MAX_CONCURRENT=4

# Request body ceiling in bytes (default 10485760 = 10 MB, the CLI stdin cap);
# larger bodies get a 413.
#BRIDGE_MAX_BODY_BYTES=10485760

# Ceiling on TOTAL child process output in bytes — stdout + stderr + the Codex
# result file, agent chatter included (default 10485760 = 10 MB). On breach the
# child is killed and the request fails 502.
#BRIDGE_MAX_PROCESS_OUTPUT_BYTES=10485760

# Cloudflare-524 heartbeat. Default "auto": heartbeat ONLY requests carrying
# Cloudflare edge headers (a heuristic on cf-ray / cf-connecting-ip), so direct
# local calls keep real error status codes while tunnel traffic survives the
# ~100s edge timeout. 0 never heartbeats; a number heartbeats every N ms for
# EVERY request (the pre-0.2 behavior).
#BRIDGE_KEEPALIVE_MS=auto

# ── Error redaction ──────────────────────────────────────────────────────────

# 0 (default): clients get a generic error message + correlation id; the full
# detail stays in the server log. Set 1 ONLY on a trusted local deployment to
# return raw backend error messages (they can reveal executable names, paths,
# and login state).
#BRIDGE_EXPOSE_ERROR_DETAILS=0

# ── Discovery convenience (opt-in) ───────────────────────────────────────────

# 1 enables GET /v1/models?key=<BRIDGE_API_KEY> for browser viewing through the
# tunnel. The key lands in browser history and proxy logs, hence opt-in.
# GET discovery only, never completions.
#BRIDGE_ALLOW_QUERY_KEY=0

# 1 lets a request that passed Cloudflare Access (edge-stamped
# Cf-Access-Jwt-Assertion header) view GET discovery routes without a key.
# Only sound while Access actually covers the hostname. Completions always
# require the Bearer.
#BRIDGE_TRUST_CF_ACCESS=0

# ── Model capabilities ───────────────────────────────────────────────────────

# Per-model capability overrides: <substring>=<context>:<maxOutput>, comma-
# separated. Keys match by SUBSTRING against the model id (longest key wins, so
# "gpt-5.6" beats "gpt" for gpt-5.6 models); family defaults use regexes and
# live in config/model-capability-defaults.json. Overrides are reported with
# caps_source: "override" on /v1/models; models matching nothing report
# caps_source: "unknown" with no figures.
#BRIDGE_MODEL_CAPS=gpt-5.5=1000000:128000,opus=200000:32000

# ── Extra CLI flags ──────────────────────────────────────────────────────────

# Extra flags appended to the claude preset (e.g. hardening). Quoted values are
# supported: --append-system-prompt "be very concise" arrives as one argument.
#BRIDGE_CLAUDE_ARGS=--permission-mode dontAsk --max-turns 1

# Exact form: a JSON array of strings, wins over BRIDGE_CLAUDE_ARGS.
#BRIDGE_CLAUDE_ARGS_JSON=["--permission-mode","dontAsk"]

# Extra flags appended to the codex preset (same quoting rules). Quotes group
# and are STRIPPED, so a TOML override must nest its quotes:
#   BRIDGE_CODEX_ARGS=-c 'model_reasoning_effort="high"'
#BRIDGE_CODEX_ARGS=

# Exact form: a JSON array of strings, wins over BRIDGE_CODEX_ARGS.
#BRIDGE_CODEX_ARGS_JSON=

# ── Env-file loading ─────────────────────────────────────────────────────────

# Explicit env-file path, overriding the .env.bridge.local / .env.local auto-load
# order. (Set inline, not in the file itself.)
#BRIDGE_ENV_FILE=

# ── Tunnel (bridge-tunnel.mjs only) ──────────────────────────────────────────

# The dedicated named Cloudflare tunnel to run. REQUIRED by bridge-tunnel.mjs.
#BRIDGE_TUNNEL_NAME=llm-bridge

# Path to that tunnel's config.yml, REQUIRED when a default ~/.cloudflared/config.yml
# already exists for another tunnel. `~` expands.
#BRIDGE_TUNNEL_CONFIG=~/.cloudflared/llm-bridge.yml

# Path to the cloudflared binary (default: cloudflared on PATH).
#CLOUDFLARED_BIN=cloudflared
