{
  "name": "local-cli-bridge",
  "version": "0.1.1",
  "description": "A minimal, self hosted OpenAI compatible adapter for one shot completions through locally authenticated CLI model tools. A development and testing bridge, not a hosted model service.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bridge": "node scripts/local-cli-bridge.mjs",
    "bridge:tunnel": "node scripts/bridge-tunnel.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JediConcepts/local-cli-bridge.git"
  },
  "homepage": "https://github.com/JediConcepts/local-cli-bridge#readme",
  "bugs": "https://github.com/JediConcepts/local-cli-bridge/issues",
  "author": "Jedi Concepts (https://jediconcepts.com)",
  "keywords": [
    "openai-compatible",
    "llm",
    "bridge",
    "claude",
    "codex",
    "cli",
    "cloudflare-tunnel"
  ],
  "bin": {
    "local-cli-bridge": "scripts/local-cli-bridge.mjs",
    "local-cli-bridge-tunnel": "scripts/bridge-tunnel.mjs"
  },
  "files": [
    "scripts",
    "config",
    "docs",
    ".env.example"
  ]
}
